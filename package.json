{
  "name": "army-shift-app",
  "version": "1.0.2",
  "description": "Greek Army Shifts Management Desktop Application",
  "author": "Hellenic Army Shift Management",
  "main": "electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "electron": "electron .",
    "electron:dev": "electron .",
    "app:build": "ng build --base-href ./",
    "electron:pack": "npm run app:build && electron-builder --dir",
    "electron:build": "npm run app:build && electron-builder",
    "test": "ng test"
  },
  "build": {
    "appId": "gr.army.shifts.manager",
    "productName": "ShiftManager",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "dist/army-shift-app/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ShiftManager.exe",
      "requestExecutionLevel": "user"
    }
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
